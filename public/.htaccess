# Hostinger Apache — static Next.js export
# Keep this minimal: trailing-slash rewrites caused sticky 301 loops in Chrome.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS (Hostinger/CDN often sets HTTPS=off behind the proxy)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Strip a wrong trailing slash on real files (.jpg/, .mp4/, …)
  # Use 302 so browsers do not permanently cache the redirect.
  RewriteRule ^(.+\.[a-zA-Z0-9]{1,8})/$ /$1 [L,R=302]

  DirectoryIndex index.html
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 hour"
  ExpiresByType image/png "access plus 1 hour"
  ExpiresByType image/jpeg "access plus 1 hour"
  ExpiresByType image/svg+xml "access plus 1 hour"
  ExpiresByType video/mp4 "access plus 1 hour"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
